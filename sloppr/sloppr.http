@sloppr_HostAddress = http://localhost:5220

// KeyIngredients endpoints
GET {{sloppr_HostAddress}}/api/KeyIngredients/
Accept: application/json

###

GET {{sloppr_HostAddress}}/api/KeyIngredients/{id}
Accept: application/json

###

PUT {{sloppr_HostAddress}}/api/KeyIngredients/{id}
Content-Type: application/json

{
  "id": 0,
  "name": "string",
  "description": "string",
  "isDeleted": true
}

###

POST {{sloppr_HostAddress}}/api/KeyIngredients/
Content-Type: application/json

{
  "name": "string",
  "description": "string",
  "isDeleted": true
}

###

DELETE {{sloppr_HostAddress}}/api/KeyIngredients/{id}

###

// MealIdeas endpoints
GET {{sloppr_HostAddress}}/api/MealIdeas/
Accept: application/json

###

GET {{sloppr_HostAddress}}/api/MealIdeas/inactive
Accept: application/json

###

GET {{sloppr_HostAddress}}/api/MealIdeas/{id}
Accept: application/json

###

PUT {{sloppr_HostAddress}}/api/MealIdeas/{id}
Content-Type: application/json

{
  "id": 0,
  "name": "string"
}

###

PUT {{sloppr_HostAddress}}/api/MealIdeas/{id}/approval
Content-Type: application/json

{
  "isUserApproved": true
}

###

DELETE {{sloppr_HostAddress}}/api/MealIdeas/{id}

###

// AiInference endpoints
POST {{sloppr_HostAddress}}/api/AiInference/meal-ideas
Content-Type: application/json

{
  "prompt": "string"
}

###

POST {{sloppr_HostAddress}}/api/AiInference/ingredient-extraction-challenges/{modelId}

###

POST {{sloppr_HostAddress}}/api/AiInference/recipes/1

###

// Recipes endpoints
GET {{sloppr_HostAddress}}/api/Recipes/
Accept: application/json

###

GET {{sloppr_HostAddress}}/api/Recipes/{id}
Accept: application/json

###

GET {{sloppr_HostAddress}}/api/Recipes/1/markdown
Accept: text/markdown

###

POST {{sloppr_HostAddress}}/api/Recipes/
Content-Type: application/json

{
  "name": "string",
  "description": "string",
  "servingCount": 4,
  "prepTimeMinutes": 10,
  "cookTimeMinutes": 20,
  "difficulty": 2,
  "notes": "string",
  "mealIdeaId": null,
  "ingredients": [
    {
      "order": 1,
      "quantity": 1,
      "unit": "cup",
      "name": "rice",
      "group": "Main",
      "note": "string"
    }
  ],
  "steps": [
    {
      "order": 1,
      "instruction": "Cook the rice.",
      "group": "Main"
    }
  ]
}

###

PUT {{sloppr_HostAddress}}/api/Recipes/{id}
Content-Type: application/json

{
  "name": "string",
  "description": "string",
  "servingCount": 4,
  "prepTimeMinutes": 10,
  "cookTimeMinutes": 20,
  "difficulty": 2,
  "notes": "string",
  "mealIdeaId": null,
  "ingredients": [
    {
      "order": 1,
      "quantity": 1,
      "unit": "cup",
      "name": "rice",
      "group": "Main",
      "note": "string"
    }
  ],
  "steps": [
    {
      "order": 1,
      "instruction": "Cook the rice.",
      "group": "Main"
    }
  ]
}

###

DELETE {{sloppr_HostAddress}}/api/Recipes/{id}

