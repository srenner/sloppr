@sloppr_HostAddress = http://localhost:5220

// AiProviders endpoints
GET {{sloppr_HostAddress}}/api/AiProviders/
Accept: application/json

###

GET {{sloppr_HostAddress}}/api/AiProviders/inactive
Accept: application/json

###

GET {{sloppr_HostAddress}}/api/AiProviders/{id}
Accept: application/json

###

// Prechecks an unsaved provider by base URL. The health path comes from
// ProviderTypeSettings in appsettings.json.
GET {{sloppr_HostAddress}}/api/AiProviders/health?BaseUrl=http://localhost:11434&HealthCheckPath=/
Accept: application/json

###

POST {{sloppr_HostAddress}}/api/AiProviders/1/health

###

GET {{sloppr_HostAddress}}/api/AiProviders/1/discover-models
Accept: application/json

###

POST {{sloppr_HostAddress}}/api/AiProviders/
Content-Type: application/json

{
  "name": "Ollama",
  "providerType": "Ollama",
  "baseUrl": "http://localhost:11434",
  "isActive": true
}

###

PUT {{sloppr_HostAddress}}/api/AiProviders/{id}
Content-Type: application/json

{
  "name": "Ollama",
  "providerType": "Ollama",
  "baseUrl": "http://localhost:11434",
  "isActive": true
}

###

DELETE {{sloppr_HostAddress}}/api/AiProviders/{id}

###

// AiModels endpoints
GET {{sloppr_HostAddress}}/api/AiModels/
Accept: application/json

###

GET {{sloppr_HostAddress}}/api/AiModels/inactive
Accept: application/json

###

GET {{sloppr_HostAddress}}/api/AiModels/{id}
Accept: application/json

###

POST {{sloppr_HostAddress}}/api/AiModels/
Content-Type: application/json

{
  "name": "Granite 4.1 8B",
  "identifier": "granite4.1:8b",
  "aiProviderId": 1,
  "contextWindow": 128000,
  "capabilities": null,
  "isActive": true
}

###

POST {{sloppr_HostAddress}}/api/AiModels/batch
Content-Type: application/json

[
  {
    "name": "Granite 4.1 8B",
    "identifier": "granite4.1:8b",
    "isActive": false,
    "aiProviderId": 1,
    "contextWindow": 128000,
    "capabilities": null
  }
]

###

PUT {{sloppr_HostAddress}}/api/AiModels/{id}
Content-Type: application/json

{
  "name": "Granite 4.1 8B",
  "identifier": "granite4.1:8b",
  "aiProviderId": 1,
  "contextWindow": 128000,
  "capabilities": null,
  "isActive": true
}

###

DELETE {{sloppr_HostAddress}}/api/AiModels/{id}

###

