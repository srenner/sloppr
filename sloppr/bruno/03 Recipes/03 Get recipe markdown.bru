meta {
  name: Get recipe markdown
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/Recipes/{{recipeId}}/markdown
  body: none
  auth: none
}

headers {
  Accept: text/markdown
}

docs {
  Renders the stored recipe with Templates/Recipes/default.md. Append ?template=<name> to
  select another template; unknown names fall back to the default.
}

tests {
  test("recipeId is set (run 'Save recipe' first)", function() {
    expect(Boolean(bru.getVar("recipeId")), "recipeId is empty").to.equal(true);
  });

  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("content type is markdown", function() {
    const contentType = String(res.getHeader("content-type") || "");
    expect(contentType).to.include("text/markdown");
  });

  test("markdown uses the default template", function() {
    const md = res.getBody();
    expect(typeof md).to.equal("string");
    expect(md.startsWith("# Standard Recipe")).to.equal(true);
    expect(md).to.include("# " + bru.getVar("recipeName"));
  });

  test("markdown has the expected sections", function() {
    const md = res.getBody();
    expect(md).to.include("## Ingredients");
    expect(md).to.include("## Steps");
  });

  test("markdown shows the recipe info", function() {
    const md = res.getBody();
    expect(md).to.include("**Servings:**");
    expect(md).to.include("**Prep Time:**");
    expect(md).to.include("**Cook Time:**");
  });

  test("difficulty line matches the stored value", function() {
    const md = res.getBody();
    const difficulty = bru.getVar("recipeDifficulty");
    if (difficulty) {
      expect(md).to.include("**Difficulty:** " + difficulty + "/3");
    } else {
      expect(md.includes("**Difficulty:**")).to.equal(false);
    }
  });

  test("steps are numbered from 1", function() {
    expect(res.getBody()).to.include("\n1. ");
  });

  test("markdown is plain, not a code fence", function() {
    const md = res.getBody();
    expect(md.includes("```")).to.equal(false);
  });

  test("no template placeholders remain", function() {
    expect(res.getBody().includes("{{")).to.equal(false);
  });
}
